[Unit]
Description=Mes Inteiro (site do quiz e webhook da Kiwify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mesinteiro
Group=mesinteiro
WorkingDirectory=/opt/mesinteiro/app
EnvironmentFile=/opt/mesinteiro/.env
Environment=NODE_ENV=production
Environment=PORT=8021
Environment=HOSTNAME=127.0.0.1
Environment=MESINTEIRO_DB=/opt/mesinteiro/dados/mesinteiro.db
ExecStart=/opt/mesinteiro/node/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=5
# A VPS é compartilhada (bot de WhatsApp, Meu Santo Protetor e o Fôlego):
# o Mês Inteiro não pode passar disto de memória nem tomar a CPU inteira.
MemoryMax=768M
CPUQuota=150%
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
