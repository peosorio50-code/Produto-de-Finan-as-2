# Configuração do Mês Inteiro na VPS: /opt/mesinteiro/.env
# Este arquivo NUNCA vai para zip, chat, GitHub ou documento.
# Depois de editar:  systemctl restart mesinteiro

# --- Site ---
# Endereço público do site, sem barra no final (o subdomínio ligado no Cloudflare Tunnel).
SITE_URL=https://mesinteiro.folegofinanceiro.shop
# E-mail de atendimento mostrado no site e usado como "responder para" dos e-mails.
CONTATO_EMAIL=

# --- Kiwify ---
# Código do checkout do produto (o trecho depois de pay.kiwify.com.br/).
KIWIFY_CHECKOUT=
# Trecho secreto do endereço do webhook. Gerado na instalação; não troque sem
# trocar também o endereço do webhook na Kiwify.
KIWIFY_WEBHOOK_SEGREDO=
# Token que a Kiwify mostra no webhook (confere a assinatura). Aceita vários,
# separados por vírgula. Vazio = só o segredo do endereço protege.
KIWIFY_TOKEN=
# Trecho do nome do produto na Kiwify (sem acento, sem diferenciar maiúscula).
# Avisos de outros produtos da conta (inclusive o Fôlego) são ignorados.
# Alternativas separadas por |
KIWIFY_PRODUTO=mes inteiro

# --- IA (Anthropic) ---
# Chave da API. Crie uma chave só para o Mês Inteiro em platform.claude.com > API keys.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# --- E-mail com o link do plano (opcional, Resend) ---
# Sem estes dois, o plano aparece só na página de obrigado e no navegador da compra.
RESEND_API_KEY=
# Remetente num domínio verificado na Resend. O domínio do Fôlego serve:
# Mês Inteiro <plano@folegofinanceiro.shop>
EMAIL_REMETENTE=

# --- Leads em outra ferramenta (opcional) ---
# Os leads já ficam no banco da VPS. Preencha só se quiser uma cópia em Make, n8n, CRM...
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# NUNCA use PAGAMENTO_MODO=teste aqui: com ele o plano sai sem cobrança.
