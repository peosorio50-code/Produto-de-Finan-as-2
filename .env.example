# Para rodar no computador: copie para .env.local e preencha.
# Na VPS, a configuração fica em /opt/mesinteiro/.env (modelo em deploy/env.exemplo).

# --- Inteligência artificial (Claude, da Anthropic) ---
# Sem a chave, o plano sai na versão padrão (sem o texto personalizado por IA).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Pagamento ---
# Sem KIWIFY_CHECKOUT, use "teste" para simular o pagamento no computador.
# NUNCA deixe "teste" no site publicado: o plano sai sem cobrança.
PAGAMENTO_MODO=teste
# KIWIFY_CHECKOUT=
# KIWIFY_WEBHOOK_SEGREDO=
# KIWIFY_TOKEN=
# KIWIFY_PRODUTO=mes inteiro

# --- Banco ---
# Padrão: ./dados/mesinteiro.db (a pasta é criada sozinha e não vai para o git).
# MESINTEIRO_DB=

# --- Site ---
# SITE_URL=http://localhost:3000
CONTATO_EMAIL=

# --- Opcionais ---
# RESEND_API_KEY=
# EMAIL_REMETENTE=
# LEADS_WEBHOOK_URL=
# LEADS_WEBHOOK_TOKEN=
